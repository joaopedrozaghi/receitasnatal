NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# ───────── App (área de membros em /app) ─────────
# Banco Postgres (Vercel → Storage → Neon). Sem ele, em produção o app mostra "em configuração".
