# URL pública do site (SEO, Open Graph, sitemap). Se vazio, usa siteUrl do site.config.ts
NEXT_PUBLIC_SITE_URL=""

# Pixels — só carregam depois que a pessoa aceita os cookies (LGPD)
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# ───────── App (área de membros em /app) ─────────
# Login padrão, igual para todas as compradoras (envie pela plataforma de checkout após a compra).
# Sem estas duas variáveis, em produção o app mostra "O app está quase pronto".
APP_LOGIN=""
APP_PASSWORD=""
# Opcional: segredo extra para assinar a sessão (somado ao login+senha).
# (trocar a senha desloga todo mundo automaticamente).
APP_SECRET=""
