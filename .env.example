# Segredo para senhas/códigos/sessões (mínimo 16 caracteres). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=""
# E-mail (resend.com): chave e remetente de um domínio verificado no Resend
RESEND_API_KEY=""
EMAIL_FROM="Equipe Receitinhas da Rô <acesso@seudominio.com.br>"
# Token do aviso de compra: a plataforma chama /api/app/compra?token=ESTE_VALOR
APP_WEBHOOK_TOKEN=""
# E-mails com acesso ao painel /app/admin (separados por vírgula)
ADMIN_EMAILS=""
