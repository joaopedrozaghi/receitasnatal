# URL pública do site (SEO, Open Graph, sitemap). Se vazio, usa siteUrl do site.config.ts
NEXT_PUBLIC_SITE_URL=""

# Pixels — só carregam depois que a pessoa aceita os cookies (LGPD)
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
# Já vêm preenchidos no código; use estas variáveis só para trocar
NEXT_PUBLIC_UTMIFY_PIXEL_ID=""
NEXT_PUBLIC_CLARITY_ID=""

# ───────── App (área de membros em /app) ─────────
